{
  "manifest_version": 3,
  "name": "eBay Filament finder",
  "version": "1.4",
  "description": "Find in-stock filament variants across eBay search results and compare listing variations.",
  "content_scripts": [
    {
      "matches": [
        "https://*.ebay.co.uk/*",
        "https://*.ebay.com/*"
      ],
      "js": [
        "js/scan-tab.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.ebay.co.uk/itm/*",
        "https://*.ebay.com/itm/*"
      ],
      "js": [
        "js/variants.js",
        "js/dock.js",
        "js/settings.js",
        "js/cards.js",
        "js/listing-data.js",
        "js/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.ebay.co.uk/sch/*",
        "https://*.ebay.com/sch/*"
      ],
      "js": [
        "js/variants.js",
        "js/dock.js",
        "js/settings.js",
        "js/cards.js",
        "js/search-bridge.js",
        "js/search.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "host_permissions": [
    "https://*.ebay.co.uk/*",
    "https://*.ebay.com/*"
  ],
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus"
  ],
  "action": {
    "default_title": "eBay Filament finder 1.4",
    "default_icon": {
      "16": "images/icons/icon-16.png",
      "32": "images/icons/icon-32.png",
      "48": "images/icons/icon-48.png",
      "128": "images/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "images/icons/icon-16.png",
    "32": "images/icons/icon-32.png",
    "48": "images/icons/icon-48.png",
    "128": "images/icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/icons/icon-48.png",
        "images/icons/icon-128.png"
      ],
      "matches": [
        "https://*.ebay.co.uk/*",
        "https://*.ebay.com/*"
      ]
    }
  ]
}
